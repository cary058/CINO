{
  "name": "sino",
  "version": "1.0.0",
  "private": true,
  "description": "СИНО — сервис эмоциональной поддержки: слушаем и не осуждаем",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-prisma-schemas.js && prisma generate --schema=prisma/schema.postgres.prisma && next build",
    "start": "next start",
    "start:demo": "npm run prisma:push:production && npm run prisma:seed && npm run telegram:set-webhook && next start -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:generate:production": "prisma generate --schema=prisma/schema.postgres.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma",
    "prisma:push:production": "prisma db push --schema=prisma/schema.postgres.prisma",
    "prisma:seed": "node prisma/seed.js",
    "admin:bootstrap": "node prisma/bootstrap-admin.js",
    "telegram:set-webhook": "node scripts/set-telegram-webhook.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.9",
    "next": "^14.2.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

