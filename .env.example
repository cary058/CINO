NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database (SQLite default for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# For PostgreSQL (Kazakhstan regional deployment):
# DATABASE_URL="postgresql://sino_user:secure_password@kz-db.internal:5432/sino_db?schema=public"

# Auth & Session Security
SESSION_SECRET="sino-super-secret-session-key-minimum-32-chars-long"
ADMIN_BOOTSTRAP_EMAIL="admin@sino.kz"

# AI Provider Abstraction
# Options: "mock" (built-in offline empathetic engine), "gemini", "openai", "custom"
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=

# App Policy & Configuration
MINIMUM_AGE=18
DEFAULT_LANGUAGE=ru
ENABLE_AI=true
ENABLE_HUMAN_SUPPORT=true
ENABLE_VOLUNTEER_REGISTRATION=true
ENABLE_PROFESSIONAL_REGISTRATION=true

# Data Retention Policy (in days)
RETENTION_AI_DAYS=90
RETENTION_HUMAN_DAYS=180
RETENTION_AUDIT_DAYS=365

# Storage (Optional / disabled by default on MVP)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email SMTP (Optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
